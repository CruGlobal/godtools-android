{
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [120],
    "editor.detectIndentation": false,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "**/build": true,
        "**/.gradle": true,
        "**/.idea": true,
        "**/.kotlin": true,
        "**/captures": true,
        "**/out": true
    },
    "search.exclude": {
        "**/build": true,
        "**/.gradle": true,
        "**/.idea": true,
        "**/.kotlin": true,
        "**/captures": true,
        "**/out": true,
        "**/src/test/snapshots/images": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.gradle/**": true
    },
    "files.associations": {
        "*.toml": "toml"
    },
    "[kotlin]": {
        "editor.tabSize": 4,
        "editor.rulers": [120]
    },
    "[json]": {
        "editor.tabSize": 2
    },
    "[xml]": {
        "editor.tabSize": 4
    },
    "[yaml]": {
        "editor.tabSize": 2
    },
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    }
}
